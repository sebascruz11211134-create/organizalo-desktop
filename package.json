{
  "name": "organizalo-desktop",
  "version": "1.0.0",
  "description": "Organ\u00edzalo.AI \u2014 App de escritorio para Mac y Windows",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac -p always",
    "build:win": "vite build && electron-builder --win",
    "build:web": "vite build --config vite.config.web.js",
    "preview": "vite preview"
  },
  "build": {
    "appId": "ai.organizalo.desktop",
    "productName": "Organ\u00edzalo.AI",
    "copyright": "\u00a9 2025 Organ\u00edzalo.AI",
    "icon": "assets/icon.png",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Organ\u00edzalo.AI"
    },
    "dmg": {
      "title": "Organ\u00edzalo.AI",
      "background": null,
      "artifactName": "Organizalo-mac.dmg",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": {
      "provider": "github",
      "owner": "sebascruz11211134-create",
      "repo": "organizalo-desktop",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "compression": "maximum"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.4",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "xlsx": "^0.18.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "latest",
    "electron-builder": "latest",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.8",
    "vite-plugin-electron": "^0.28.4",
    "wait-on": "^7.2.0"
  }
}
